# jadslink-app — variables de entorno
# Copiar a .env y completar.

# SQLite local (ruta absoluta en el servidor). En Hostinger:
#   sqlite:////home/<usuario>/jadslink-app/data/hotspot.db
DATABASE_URL=sqlite:///./data/hotspot.db

# Secreto para firmar tokens de sesión. Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME

ENVIRONMENT=production

# Contraseña del panel admin (cambia en producción)
ADMIN_PASSWORD=admin123

# SMTP para alertas de gateway offline (dejar vacío para desactivar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu_app_password
